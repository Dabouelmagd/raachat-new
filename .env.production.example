# انسخيه إلى .env.production (وماترفعيهوش على git) وعدّلي القيم
DOMAIN=example.com                 # هتشتغل على app.example.com و api.example.com و admin.example.com (لوحة الإدارة)
# OLD_DOMAIN=old.example.com       # اختياري وقت الانتقال بس: الدومين القديم يفضل شغّال جنب الجديد.
                                   # بيقراه scripts/add-nginx-site.sh وحده (مش في compose ولا في كود التطبيق).
                                   # ولازم معاه أصوله في CORS_EXTRA، وإلا طلبات الدومين القديم تترفض.
OWNER_CONTACTS=01xxxxxxxxx         # رقمك أو إيميلك (ممكن أكتر من واحد بفاصلة): أول دخول بيه للوحة بيبقى «مالك»
POSTGRES_PASSWORD=                 # openssl rand -hex 24
JWT_SECRET=                        # openssl rand -hex 32

# رمز التحقق (OTP): لازم واحدة منهم على الأقل وإلا محدش هيقدر يسجّل دخول
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
RESEND_KEY=
EMAIL_FROM=

# الترجمة: الافتراضي LibreTranslate المجاني (خدمة جوه compose) — مش محتاج أي سطر هنا.
# السطر ده يتفعّل **بس** لو عايزة توقّفيه (قيمة فاضية = إيقاف صريح) أو تشاوري على
# خدمة على عنوان تاني. متحطيهوش فاضيًا وهو شغّال — الفاضي بيطفّيه.
# LIBRETRANSLATE_URL=

# مفتاح جوجل المدفوع — احتياطي بس: بيشتغل لما LibreTranslate متوقّف
GOOGLE_TRANSLATE_KEY=

# المكالمات خلف الشبكات المقفولة (اختياري لكن مهم): شغّلي --profile turn
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:SERVER_IP:3478      # IP السيرفر العام
TURN_SECRET=                       # openssl rand -hex 24

# إشعارات Push (مكالمات/رسايل والتطبيق مقفول). ولّديهم مرة واحدة: cd server && npm run vapid
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:you@yourdomain.com
LETSENCRYPT_EMAIL=

# الحذف التلقائي لمدد الاحتفاظ المنشورة في سياسة الخصوصية (الستوري ٢٤ ساعة · أكواد
# التحقق · الجلسات الملغاة · سجل إعلانات الأقل من ١٨ · البلاغات بعد سنتين).
#   dry = يقول هيمسح إيه بدون أي حذف (الافتراضي، آمن) · on = يمسح فعلًا · off = موقوف
# شوفي سطر «🧪 حذف تلقائي» في لوج الـ api وراجعي الأرقام قبل ما تحوّليها on.
RETENTION=dry
