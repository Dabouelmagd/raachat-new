# انسخيه إلى .env.production (وماترفعيهوش على git) وعدّلي القيم
DOMAIN=example.com                 # هتشتغل على app.example.com و api.example.com و admin.example.com (لوحة الإدارة)
OWNER_CONTACTS=01xxxxxxxxx         # رقمك أو إيميلك (ممكن أكتر من واحد بفاصلة): أول دخول بيه للوحة بيبقى «مالك»
POSTGRES_PASSWORD=                 # openssl rand -hex 24
JWT_SECRET=                        # openssl rand -hex 32

# رمز التحقق (OTP): لازم واحدة منهم على الأقل وإلا محدش هيقدر يسجّل دخول
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
RESEND_KEY=
EMAIL_FROM=

# الترجمة الحقيقية (بكرة)
GOOGLE_TRANSLATE_KEY=

# المكالمات خلف الشبكات المقفولة (اختياري لكن مهم): شغّلي --profile turn
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:SERVER_IP:3478      # IP السيرفر العام
TURN_SECRET=                       # openssl rand -hex 24

# إشعارات Push (مكالمات/رسايل والتطبيق مقفول). ولّديهم مرة واحدة: cd server && npm run vapid
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:you@yourdomain.com
LETSENCRYPT_EMAIL=
