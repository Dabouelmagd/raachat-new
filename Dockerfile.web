# الواجهة (Vite) + Caddy: بيقدّم الملفات الثابتة وبيعمل reverse proxy للـ API مع HTTPS تلقائي
FROM node:22-alpine AS build
WORKDIR /app
ARG VITE_API_URL
ARG VITE_ADMIN_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_ADMIN_URL=$VITE_ADMIN_URL
COPY package*.json ./
RUN npm ci
COPY index.html vite.config.ts tsconfig*.json postcss.config.js tailwind.config.js ./
COPY src ./src
# public/ فيه الصفحات القانونية واللوجو وملف الـ service worker — من غيرها بيطلعوا 404
COPY public ./public
RUN npx vite build

# لوحة الإدارة (admin.دومينك)
FROM node:22-alpine AS admin
WORKDIR /app
ARG VITE_API_URL
ARG VITE_ADMIN_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_ADMIN_URL=$VITE_ADMIN_URL
COPY admin/package*.json ./
RUN npm ci
COPY admin/index.html admin/vite.config.js admin/postcss.config.js ./
COPY admin/src ./src
RUN npx vite build

FROM caddy:2-alpine
LABEL project=rachat
COPY --from=build /app/dist /srv
COPY --from=admin /app/dist /srv-admin
COPY deploy/Caddyfile /etc/caddy/Caddyfile
